---
/**
 * src/pages/sessions/[slug].astro
 *
 * Generates one participant page per session in src/content/sessions/.
 * URL: /sessions/session-1, /sessions/session-2, etc.
 *
 * Cross-references: session frontmatter lists theory slugs.
 * We look up each theory to render the concept-chip rows with
 * live links to /theories/[slug].
 */
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map(session => ({
    params: { slug: session.id },
    props:  { session },
  }));
}

const { session } = Astro.props;

// Look up all theories for this session
const theoryEntries = await Promise.all(
  (session.data.theories ?? []).map(id => getEntry('theories', id))
);
const theories = theoryEntries.filter(Boolean);

// Short "what we'll do" text (markdown body) and the after-session recap
const { Content } = await render(session);
const keyIdeas = await Promise.all(
  session.data.keyIdeas.map(async k => ({
    ...k,
    entry: k.theory ? await getEntry('theories', k.theory) : null,
  }))
);
const hasRecap = keyIdeas.length > 0;

// Asks and questions can mark phrase breaks with "|": each phrase wraps as a
// unit where it fits, so lines break naturally ("so that long sentences /
// and asks don't get split"), not wherever the line runs out.
const phrases = (s: string) => s.split('|').map(p => p.trim()).filter(Boolean);

const n = session.data.number;
const askLabel = session.data.askLabel ?? `Your task before Session ${n + 1}`;
---

<Base
  title={`Session ${session.data.number}: ${session.data.tagline}`}
  bodyClass="session-page"
  currentNav="sessions"
  brandRole="Participant"
>

  <section class="session-section">

    <!-- Hero -->
    <div class="session-hero-inner">
      <div class="session-hero-text">
        <div class="session-breadcrumb">
          <a class="breadcrumb-parent" href="/sessions">The Sessions</a>
          <span class="breadcrumb-sep" aria-hidden="true">»</span>
          <span class="breadcrumb-current">Session {session.data.number}</span>
        </div>
        <h1 class="session-title">{session.data.tagline}</h1>
        {session.data.subtitle && (
          <p class="session-subtitle">{session.data.subtitle}</p>
        )}
      </div>
      <img
        class="session-fox"
        src={`/images/fox/${session.data.fox}`}
        alt=""
        aria-hidden="true"
        style="opacity:0;"
        id="session-hero-fox"
      />
    </div>

    <!-- Card stack -->
    <div class="session-stack" data-animate>

      <!-- Card 1: Before the session: priming question, what we'll do, what to bring -->
      {session.data.primingQuestion && (
        <div class="session-card">
          <p class="section-overline">Before the session</p>
          <p class="prep-section-label">Think about</p>
          <blockquote class="priming-question phrased">
            {phrases(`“${session.data.primingQuestion}”`).map(p => <><span class="phrase">{p}</span>{' '}</>)}
          </blockquote>
          <div class="session-body"><Content /></div>
          {session.data.outcomes.length > 0 && (
            <div class="prep-section">
              <p class="prep-section-label">By the end you will have</p>
              <ol class="task-steps">
                {session.data.outcomes.map(o => {
                  const [verb, ...rest] = o.split(' ');
                  return <li><strong>{verb}</strong> {rest.join(' ')}</li>;
                })}
              </ol>
            </div>
          )}
          {session.data.prep && (
            <div class="prep-section">
              <p class="prep-section-label">Bring</p>
              <p class="prep-section-text">{session.data.prep}</p>
              {session.data.prepFallback && (
                <p class="prep-section-text prep-fallback">{session.data.prepFallback}</p>
              )}
            </div>
          )}
        </div>
      )}

      <!-- Card 2: the ask, open by default: it's what people come back for mid-week -->
      {session.data.ask && (
        <details class="session-card task-card" open>
          <summary class="card-summary">
            <span class="section-overline">After the session</span>
            <span class="card-summary-title">{askLabel}</span>
            <span class="btn btn--quiet card-toggle" aria-hidden="true"><span class="when-closed">Show</span><span class="when-open">Hide</span></span>
          </summary>
          <blockquote class="priming-question task-ask phrased">
            {phrases(`“${session.data.ask}”`).map(p => <><span class="phrase">{p}</span>{' '}</>)}
          </blockquote>
          {session.data.askSteps.length > 0 && (
            <ol class="task-steps">
              {session.data.askSteps.map(step => <li>{step}</li>)}
            </ol>
          )}
          {session.data.askLinks.length > 0 && (
            <div class="task-links">
              {session.data.askLinks.map(l => (
                <p class="task-link">
                  {l.intro && <span>{l.intro}</span>}
                  <a class="btn btn--quiet" href={l.href}>{l.text} →</a>
                </p>
              ))}
            </div>
          )}
          {session.data.askNoComputer && (
            <div class="task-help">
              <p>{session.data.askNoComputer}</p>
              <p>Using a computer and getting stuck? Tell your facilitator: we'll pair you up.</p>
              <a class="btn btn--primary btn--green task-help-link" href="/facilitator/computer-tasks">Step-by-step computer help (printable) →</a>
            </div>
          )}
        </details>
      )}

      <!-- Card 3: key ideas, folded so the session isn't spoiled -->
      {hasRecap && (
        <details class="concepts-card recap-card">
          <summary class="card-summary">
            <span class="concepts-card-overline">After the session</span>
            <span class="card-summary-title">The key ideas</span>
            <span class="card-summary-sub">Looking for the slides? Everything in them is here, with more in the Theory Library.</span>
            <span class="btn btn--quiet card-toggle" aria-hidden="true"><span class="when-closed">Show</span><span class="when-open">Hide</span></span>
          </summary>
          <div class="concept-chips">
            {keyIdeas.map(k => k.entry ? (
              <a class="theory-row" href={`/theories/${k.theory}`}>
                <div class="theory-row-text">
                  <span class="theory-row-name">{k.idea}</span>
                  {k.detail && <span class="theory-row-summary">{k.detail}</span>}
                </div>
                <span class="theory-row-arrow" aria-hidden="true">&#x2192;</span>
              </a>
            ) : (
              <div class="theory-row">
                <div class="theory-row-text">
                  <span class="theory-row-name">{k.idea}</span>
                  {k.detail && <span class="theory-row-summary">{k.detail}</span>}
                </div>
              </div>
            ))}
          </div>
          {session.data.canvas && (
            <div class="prep-section recap-section">
              <p class="prep-section-label">Where this fits in your canvas</p>
              <p class="prep-section-text">{session.data.canvas}</p>
            </div>
          )}
        </details>
      )}

      <!-- Theory list, only for sessions without key ideas (the ideas link to theories) -->
      {!hasRecap && theories.length > 0 && (
        <div class="concepts-card">
          <p class="concepts-card-overline">What this session draws on</p>
          <div class="concept-chips">
            {theories.map(t => t && (
              <a class="theory-row" href={`/theories/${t.id}`}>
                <div class="theory-row-text">
                  <span class="theory-row-name">{t.data.headline}</span>
                  <span class="theory-row-summary">{t.data.summary}</span>
                </div>
                <span class="theory-row-arrow" aria-hidden="true">&#x2192;</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="facilitator-line">
        Running this session? <a href={`/facilitator/session-${n}`}>The facilitator blueprint →</a>
      </p>

    </div>
  </section>

  <fragment slot="scripts">
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const fox = document.getElementById('session-hero-fox');
        if (fox && (window as any).anime) {
          (window as any).anime({
            targets: fox,
            opacity: [0, 1],
            translateX: [18, 0],
            duration: 700,
            delay: 300,
            easing: 'easeOutCubic',
          });
        }
      });
    </script>
  </fragment>

</Base>
