---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const papers = await getCollection('papers');
const sessions = await getCollection('sessions');
sessions.sort((a, b) => a.data.number - b.data.number);

// Each paper appears once: under the first session that uses it, oldest
// first, then everything else under "Further reading".
const byYear = [...papers].sort((a, b) => a.data.year - b.data.year);
const seen = new Set<string>();
const groups = sessions.map(session => {
  const items = byYear.filter(p => !seen.has(p.id) && p.data.sessions.includes(session.data.number));
  items.forEach(p => seen.add(p.id));
  return { label: `Session ${session.data.number}`, title: session.data.tagline, items };
}).filter(g => g.items.length > 0);
const rest = byYear.filter(p => !seen.has(p.id));
if (rest.length) groups.push({ label: 'More', title: 'Further reading', items: rest });
---

<Base
  title="Evidence Base"
  bodyClass="session-page library-page"
  currentNav="theories"
  brandRole="Theory Library"
  brandRoleClass="brand-role--green"
>

  <section class="library-section">
    <div class="library-inner">
      <div class="library-hero-inner">
        <div class="library-hero-text">
          <div class="library-overline">The Evidence Base</div>
          <h1 class="library-title">Research summaries</h1>
          <p class="library-lede">
            Plain-English summaries of the research behind Teaching That Sticks.
            Each one says what the researchers did, what they found, how far to trust
            it, and what it means for your teaching.
            <a href="/theories">Browse the theory library →</a>
          </p>
        </div>
        <img class="library-fox" src="/images/fox/reading.png" alt="Fox reading" />
      </div>

      {groups.map(({ label, title, items }) => (
        <div class="theory-group">
          <p class="theory-group-session">{label}</p>
          <h2 class="theory-group-title">{title}</h2>
          <div class="theory-list">
            {items.map((paper) => (
              <div class="theory-card">
                <div class="theory-card-main">
                  <div class="theory-card-name">{paper.data.headline}</div>
                  <div class="theory-card-summary">
                    {paper.data.authors.split(',')[0]} · {paper.data.year}
                  </div>
                </div>
                <div class="theory-card-action">
                  <a class="btn btn--green" href={`/papers/${paper.id}`}>Read →</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

</Base>
