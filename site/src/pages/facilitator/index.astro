---
/**
 * src/pages/facilitator/index.astro
 *
 * Facilitator Hub — sky theme. Lists all facilitator entries:
 * - Session blueprints (type: blueprint)
 * - Reference materials (type: resource)
 * - Stub cards for coming-soon content
 *
 * URL: /facilitator
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = await getCollection('facilitator');
const blueprints = entries
  .filter(e => e.data.type === 'blueprint')
  .sort((a, b) => a.data.order - b.data.order);
const resources = entries
  .filter(e => e.data.type === 'resource')
  .sort((a, b) => a.data.order - b.data.order);
const preItems = entries
  .filter(e => e.data.type === 'pre-programme')
  .sort((a, b) => a.data.order - b.data.order);
const commsItems = entries
  .filter(e => e.data.type === 'comms')
  .sort((a, b) => a.data.order - b.data.order);

// Hub order follows a new facilitator's path: start → prepare → deliver → evaluate.
const byId = (id: string) => entries.find(e => e.id === id);
const startIds = ['train-the-trainer'];
const prepareIds = ['technical-brief', 'computer-tasks', 'theory-guide', 'session-plan-example'];
const evaluateIds = ['evaluation-toolkit', 'portfolio-mapping'];
const placed = [...startIds, ...prepareIds, ...evaluateIds];
const pick = (ids: string[]) => ids.map(byId).filter(Boolean) as typeof entries;
const sections = [
  { header: '1 · Start here', eyebrow: (e: any) => e.data.type === 'pre-programme' ? 'Programme setup' : 'Facilitator development',
    items: [...preItems, ...pick(startIds)] },
  { header: '2 · Prepare', eyebrow: () => 'Reference',
    items: [...pick(prepareIds), ...resources.filter(r => !placed.includes(r.id))] },
  { header: '3 · Deliver', eyebrow: (e: any) => e.data.session ? `Session ${e.data.session}` : 'All three, one day', items: blueprints, blueprint: true },
  { header: 'Messages between sessions', eyebrow: (e: any) => `Before session ${e.data.session}`, items: commsItems },
  { header: '4 · Evaluate and record', eyebrow: (e: any) => e.id === 'portfolio-mapping' ? 'For participants' : 'Evaluation', items: pick(evaluateIds) },
].filter(sec => sec.items.length > 0);
---

<Base
  title="Facilitator Hub"
  bodyClass="session-page facilitator-hub-page"
  currentNav="facilitator"
  brandRole="Facilitator Hub"
  brandRoleClass="brand-role--sky"
>

  <main class="library-section">
    <div class="library-inner">

      <!-- Hero -->
      <div class="library-hero-inner">
        <div class="library-hero-text">
          <p class="library-overline">Facilitator Hub</p>
          <h1 class="library-title">Run this programme</h1>
          <p class="library-lede">
            Everything you need to run Teaching That Lands, in the order
            you'll need it.
          </p>
        </div>
        <img
          id="facilitator-hub-fox"
          class="library-fox"
          src="/images/fox/blueprint_demonstrate.png"
          alt=""
          aria-hidden="true"
          style="opacity:0;"
        />
      </div>

      {sections.map(sec => (
        <div class="fac-hub-section">
          <p class="fac-section-header">{sec.header}</p>
          <div class="fac-cards-grid" data-animate>
            {sec.items.map(entry => (
              <a href={`/facilitator/${entry.id}`} class="fac-card">
                <p class="fac-card-eyebrow">{sec.eyebrow(entry)}</p>
                <h2 class="fac-card-title">{entry.data.title}</h2>
                {entry.data.tagline && (
                  <p class="fac-card-tagline">{entry.data.tagline}</p>
                )}
                {sec.blueprint && entry.data.duration && (
                  <p class="fac-card-meta">⏱ {entry.data.duration} &nbsp;·&nbsp; Facilitator guide</p>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}


    </div>
  </main>

  <fragment slot="scripts">
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const fox = document.getElementById('facilitator-hub-fox') as HTMLImageElement | null;
        if (!fox) return;
        const animeFn = (window as any).anime ?? null;
        if (!animeFn) { fox.style.opacity = '1'; return; }
        animeFn({
          targets: fox,
          opacity: [0, 1],
          translateY: [18, 0],
          duration: 700,
          easing: 'easeOutCubic',
          delay: 200,
        });
      });
    </script>
  </fragment>

</Base>
