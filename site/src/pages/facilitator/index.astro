---
/**
 * src/pages/facilitator/index.astro
 *
 * Facilitator Hub — sky theme. Two levels:
 * - Planning any teaching: good practice, not tied to this programme
 * - Running Teaching That Lands: get a yes → plan → prepare → deliver → evaluate
 *
 * URL: /facilitator
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = await getCollection('facilitator');
const blueprints = entries
  .filter(e => e.data.type === 'blueprint')
  .sort((a, b) => a.data.order - b.data.order);
const resources = entries
  .filter(e => e.data.type === 'resource')
  .sort((a, b) => a.data.order - b.data.order);
const preItems = entries
  .filter(e => e.data.type === 'pre-programme')
  .sort((a, b) => a.data.order - b.data.order);
const commsItems = entries
  .filter(e => e.data.type === 'comms')
  .sort((a, b) => a.data.order - b.data.order);

// Two levels: planning any teaching (not tied to this programme), then the
// path to running Teaching That Lands. Each level says once who it's for;
// cards are labelled by depth or step, and name a reader only where the
// reader is someone else (the Briefing is handed on; two pages are for participants).
const byId = (id: string) => entries.find(e => e.id === id);
const pick = (ids: string[]) => ids.map(byId).filter(Boolean) as typeof entries;
const planningIds = ['before-you-plan', 'design-check'];
const yesIds = ['getting-traction', 'setup-and-justify'];
const planIds = ['task-and-finish'];
const prepareIds = ['train-the-trainer', 'technical-brief', 'theory-guide', 'session-plan-example', 'computer-tasks'];
const evaluateIds = ['evaluation-toolkit', 'portfolio-mapping'];
const placed = [...planningIds, ...yesIds, ...planIds, ...prepareIds, ...evaluateIds];
const labels: Record<string, string> = {
  'before-you-plan': 'Two minutes',
  'design-check': 'The full check',
  'getting-traction': 'Start here',
  'setup-and-justify': 'Hand this on',
  'task-and-finish': 'Checklist',
  'train-the-trainer': 'Facilitator development',
  'computer-tasks': 'Handout',
  'evaluation-toolkit': 'Evaluation',
  'portfolio-mapping': 'For participants',
};
const label = (e: any) => labels[e.id] ?? 'Reference';
const sections = [
  { group: 'Planning any teaching',
    groupIntro: 'For anyone who asks for, plans or approves teaching. Not tied to this programme.',
    header: '', eyebrow: label, items: pick(planningIds) },
  { group: 'Running Teaching That Lands',
    groupIntro: 'For whoever sets up and runs a cohort, in the order you\'ll need it.',
    header: '1 · Get a yes', eyebrow: label,
    items: [...pick(yesIds), ...preItems.filter(e => !placed.includes(e.id))] },
  { header: '2 · Plan the cohort', eyebrow: label, items: pick(planIds) },
  { header: '3 · Prepare', eyebrow: label,
    items: [...pick(prepareIds), ...resources.filter(r => !placed.includes(r.id))] },
  { header: '4 · Deliver', eyebrow: (e: any) => e.data.session ? `Session ${e.data.session}` : 'All three, one day', items: blueprints, blueprint: true },
  { header: 'Messages between sessions', eyebrow: (e: any) => `Before session ${e.data.session}`, items: commsItems },
  { header: '5 · Evaluate and record', eyebrow: label, items: pick(evaluateIds) },
].filter(sec => sec.items.length > 0);
---

<Base
  title="Facilitator Hub"
  bodyClass="session-page facilitator-hub-page"
  currentNav="facilitator"
  brandRole="Facilitator Hub"
  brandRoleClass="brand-role--sky"
>

  <main class="library-section">
    <div class="library-inner">

      <!-- Hero -->
      <div class="library-hero-inner">
        <div class="library-hero-text">
          <p class="library-overline">Facilitator Hub</p>
          <h1 class="library-title">Plan it, then run it</h1>
          <p class="library-lede">
            Good practice for planning any teaching, then everything you need
            to run Teaching That Lands, in the order you'll need it.
          </p>
        </div>
        <img
          id="facilitator-hub-fox"
          class="library-fox"
          src="/images/fox/blueprint_demonstrate.png"
          alt=""
          aria-hidden="true"
          style="opacity:0;"
        />
      </div>

      {sections.map(sec => (
        <div class="fac-hub-section">
          {sec.group && <h2 class="fac-group-title">{sec.group}</h2>}
          {sec.groupIntro && <p class="fac-group-intro">{sec.groupIntro}</p>}
          {sec.header && <p class="fac-section-header">{sec.header}</p>}
          <div class="fac-cards-grid" data-animate>
            {sec.items.map(entry => (
              <a href={`/facilitator/${entry.id}`} class="fac-card">
                <p class="fac-card-eyebrow">{sec.eyebrow(entry)}</p>
                <h2 class="fac-card-title">{entry.data.title}</h2>
                {entry.data.tagline && (
                  <p class="fac-card-tagline">{entry.data.tagline}</p>
                )}
                {sec.blueprint && entry.data.duration && (
                  <p class="fac-card-meta">⏱ {entry.data.duration} &nbsp;·&nbsp; Facilitator guide</p>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}


    </div>
  </main>

  <fragment slot="scripts">
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const fox = document.getElementById('facilitator-hub-fox') as HTMLImageElement | null;
        if (!fox) return;
        const animeFn = (window as any).anime ?? null;
        if (!animeFn) { fox.style.opacity = '1'; return; }
        animeFn({
          targets: fox,
          opacity: [0, 1],
          translateY: [18, 0],
          duration: 700,
          easing: 'easeOutCubic',
          delay: 200,
        });
      });
    </script>
  </fragment>

</Base>
