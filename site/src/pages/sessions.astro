---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const sessions = await getCollection('sessions');
sessions.sort((a, b) => a.data.number - b.data.number);
---

<Base title="Sessions" bodyClass="session-page" currentNav="sessions" brandRole="Sessions">

  <section class="session-section">
    <div class="session-hero-inner">
      <div class="session-hero-text">
        <span class="session-overline">The Programme</span>
        <h1 class="session-title">Three 90-minute sessions</h1>
        <p class="session-subtitle">
          One week apart. Bring one session you teach (or would like to teach)
          and leave with it rebuilt. No prerequisites. Free and open.
        </p>
      </div>
      <img
        id="sessions-fox"
        class="session-fox"
        src="/images/fox/lightbulb_off.png"
        alt=""
        aria-hidden="true"
      />
    </div>

    <div class="session-stack" data-animate>
      <div class="session-card">
        <p class="section-overline">Suggested outcomes</p>
        <p class="prep-section-label">By the end of the three sessions you could have</p>
        <p class="prep-section-text">These are ours. Yours matter more: pick the ones that fit, reword them, or write your own, based on what you need from the programme.</p>
        <ol class="task-steps">
          <li><strong>Redesigned</strong> a slide from your own teaching to cut the clutter and work for the back row.</li>
          <li><strong>Made</strong> ten minutes of your session active, using a named strategy that suits where it really happens.</li>
          <li><strong>Written</strong> one to three outcomes for your session with verbs someone could observe, and matched each to the evidence that would show it.</li>
          <li><strong>Checked</strong> that your outcomes, activities and evidence all show the same performance.</li>
          <li><strong>Planned</strong> your follow-through: what you'll revisit at 30, 60 and 90 days, who will hold you to it, and the support you need from them.</li>
        </ol>
        <p class="prep-section-text">All of it lands on one page: your session, rebuilt on a six-box design canvas.</p>
      </div>
      {sessions.map(s => (
        <div class="prog-card">
          <div class="prog-card-main">
            <span class="prog-card-overline">Session {s.data.number}</span>
            <h2 class="prog-card-title">{s.data.tagline}</h2>
            {s.data.subtitle && <p class="prog-card-body">{s.data.subtitle}</p>}
            <div class="prog-card-meta">
              <span>{s.data.duration}</span>
            </div>
          </div>
          <div class="prog-card-action">
            <a class="btn" href={`/sessions/${s.id}`}>Session {s.data.number} →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <fragment slot="scripts">
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const fox = document.getElementById('sessions-fox') as HTMLImageElement;
        if (!fox) return;
        setTimeout(() => {
          fox.src = '/images/fox/lightbulb_on.png';
          (window as any).anime({ targets: fox, scale: [0.88, 1.08, 1], duration: 500, easing: 'easeOutBack' });
        }, 700);
      });
    </script>
  </fragment>

</Base>
