---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const sessions = await getCollection('sessions');
sessions.sort((a, b) => a.data.number - b.data.number);
---

<Base title="Sessions" bodyClass="session-page" currentNav="sessions" brandRole="Sessions">

  <section class="session-section">
    <div class="session-hero-inner">
      <div class="session-hero-text">
        <span class="session-overline">The Programme</span>
        <h1 class="session-title">Three 90-minute sessions</h1>
        <p class="session-subtitle">
          One week apart. Bring one session you teach (or would like to teach)
          and leave with it rebuilt. No prerequisites. Free and open.
        </p>
      </div>
      <img
        id="sessions-fox"
        class="session-fox"
        src="/images/fox/lightbulb_off.png"
        alt=""
        aria-hidden="true"
      />
    </div>

    <div class="session-stack" data-animate>
      <div class="session-card">
        <p class="prep-section-label">By the end of the three sessions you will be able to</p>
        <ol class="task-steps">
          <li><strong>Redesign</strong> a slide from your own teaching so it's clear and easy to read from the back of the room.</li>
          <li><strong>Make</strong> ten minutes of your session active, using a technique or tool that suits where you teach.</li>
          <li><strong>Say</strong> what you want learners to be able to do by the end of your session, in a way you could watch or check, and work out how you'll check it.</li>
          <li><strong>Show</strong> how your session links up: the change you want &rarr; what learners do &rarr; how you'll check it &rarr; what you'd see change.</li>
          <li><strong>Plan</strong> what happens after your session: what you'll look at again after 30, 60 and 90 days, who will keep you on track, and what help you need from them.</li>
        </ol>
      </div>
      {sessions.map(s => (
        <div class="prog-card">
          <div class="prog-card-main">
            <span class="prog-card-overline">Session {s.data.number}</span>
            <h2 class="prog-card-title">{s.data.tagline}</h2>
            {s.data.subtitle && <p class="prog-card-body">{s.data.subtitle}</p>}
            <div class="prog-card-meta">
              <span>{s.data.duration}</span>
            </div>
          </div>
          <div class="prog-card-action">
            <a class="btn" href={`/sessions/${s.id}`}>Session {s.data.number} →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <fragment slot="scripts">
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const fox = document.getElementById('sessions-fox') as HTMLImageElement;
        if (!fox) return;
        setTimeout(() => {
          fox.src = '/images/fox/lightbulb_on.png';
          (window as any).anime({ targets: fox, scale: [0.88, 1.08, 1], duration: 500, easing: 'easeOutBack' });
        }, 700);
      });
    </script>
  </fragment>

</Base>
