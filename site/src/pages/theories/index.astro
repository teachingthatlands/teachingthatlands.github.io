---
/**
 * src/pages/theories/index.astro — Theory Library listing
 * Groups theories by session, matching the prototype layout.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Sessions in order; theories in the order each session lists them
const sessions = await getCollection('sessions');
sessions.sort((a, b) => a.data.number - b.data.number);

const allTheories = await getCollection('theories');
const theoryMap = Object.fromEntries(allTheories.map(t => [t.id, t]));

// Each theory appears once: under the first session that uses it,
// then everything else under "Also in the library".
const seen = new Set<string>();
const groups = sessions.map(session => {
  const theories = (session.data.theories ?? [])
    .filter(id => theoryMap[id] && !seen.has(id))
    .map(id => { seen.add(id); return theoryMap[id]; });
  return { label: `Session ${session.data.number}`, title: session.data.tagline, theories };
}).filter(g => g.theories.length > 0);
const rest = allTheories
  .filter(t => !seen.has(t.id))
  .sort((a, b) => a.data.headline.localeCompare(b.data.headline));
if (rest.length) groups.push({ label: 'More', title: 'Also in the library', theories: rest });
---

<Base title="Theory Library" bodyClass="session-page" currentNav="theories" brandRole="Theory Library" brandRoleClass="brand-role--green">

  <main class="library-section">
    <div class="library-inner">

      <!-- Hero -->
      <div class="library-hero-inner">
        <div class="library-hero-text">
          <p class="library-overline">The Theory Library</p>
          <h1 class="library-title">The evidence behind the teaching</h1>
          <p class="library-lede">
            Plain-language overviews of the {allTheories.length} ideas behind
            the programme, each linked to the original research. <a href="/papers">Read the evidence summaries →</a>
          </p>
        </div>
        <img
          id="library-fox"
          class="library-fox"
          src="/images/fox/reading.png"
          alt=""
          aria-hidden="true"
          style="opacity:0;"
        />
      </div>

      <!-- Session groups -->
      {groups.map(({ label, title, theories }) => {
        return (
          <div class="theory-group">
            <p class="theory-group-session">{label}</p>
            <h2 class="theory-group-title">{title}</h2>
            <div class="theory-list" data-animate>
              {theories.map(t => (
                <div class="theory-card">
                  <div class="theory-card-main">
                    <p class="theory-card-name">{t.data.headline}</p>
                    <p class="theory-card-summary"><em>{t.data.title}</em>: {t.data.summary}</p>
                  </div>
                  <div class="theory-card-action">
                    <a class="btn btn--green" href={`/theories/${t.id}`}>Read →</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}

    </div>
  </main>

  <fragment slot="scripts">
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const fox = document.getElementById('library-fox') as HTMLImageElement | null;
        if (!fox) return;
        const animeFn = (window as any).anime ?? null;
        if (!animeFn) { fox.style.opacity = '1'; return; }
        animeFn({
          targets: fox,
          opacity: [0, 1],
          translateY: [20, 0],
          duration: 800,
          easing: 'easeOutCubic',
          delay: 300,
        });
      });
    </script>
  </fragment>

</Base>
