# Supply-chain safety. Compromised npm releases usually do their damage in
# an install script, and are usually caught and pulled within days.

# Never run dependencies' install scripts. Nothing here needs one: esbuild
# and fsevents ship prebuilt binaries. (`npm run dev` etc. still work.)
ignore-scripts=true

# Only install versions published at least 7 days ago. Needs npm 11 or
# later (`npm -v`); npm 10 silently ignores it. For an urgent fix, override:
#   npm install <pkg>@<version> --min-release-age=0
min-release-age=7
